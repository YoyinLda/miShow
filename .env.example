SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Puntoticket: descubrimiento por venues. Apagado por defecto (true | false).
# También se habilita con el flag --venue-discovery.
# PUNTOTICKET_VENUE_DISCOVERY=

# Puntoticket: tope de páginas de venue por corrida (entero >= 0, <= tope duro).
# Si no se define, usa MAX_EVENTS. El flag --max-venue-pages tiene prioridad.
# PUNTOTICKET_MAX_VENUE_PAGES=

# Puntoticket: tope duro de páginas de venue (entero >= 0).
# Si no se define, usa MAX_EVENTS_LIMIT.
# PUNTOTICKET_MAX_VENUE_PAGES_LIMIT=

# Puntoticket: respaldo con lista fija de URLs de venues separadas por coma.
# Solo se usa con el descubrimiento por venues habilitado; prevalece sobre db-venues.
# PUNTOTICKET_VENUE_URLS=

# Puntoticket: dias para reintentar paginas de venue que respondieron 404 (entero >= 0).
# Default: 30.
# PUNTOTICKET_VENUE_NOTFOUND_RETRY_DAYS=
