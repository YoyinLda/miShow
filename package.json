{
  "name": "mishow",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "scrapers/*",
    "apps/*"
  ],
  "scripts": {
    "qa": "npm run typecheck && npm run lint && npm test",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "puntoticket:listing": "npm run puntoticket:listing -w @mishow/scraper-puntoticket --",
    "puntoticket:detail": "npm run puntoticket:detail -w @mishow/scraper-puntoticket --",
    "puntoticket:scrape": "npm run puntoticket:scrape -w @mishow/scraper-puntoticket --",
    "supabase:start": "supabase start",
    "supabase:reset": "supabase db reset --local --no-seed",
    "supabase:test": "supabase test db --local",
    "supabase:lint": "supabase db lint --local --level warning --fail-on error",
    "supabase:advisors": "supabase db advisors --local --type all --level info --fail-on error"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "eslint": "^9.35.0",
    "supabase": "2.117.0",
    "tsx": "4.19.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}
